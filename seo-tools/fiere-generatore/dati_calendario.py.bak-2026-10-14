    _,_,_,_,s,e,c,_,_=FIERE[fid]
    y1,m1,d1=map(int,s.split('-')); y2,m2,d2=map(int,e.split('-'))
    if not c: return f"{MESI[m1-1]} {y1} (date da confermare)"
