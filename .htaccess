# Danova Tech — configurazione Apache (hosting classico, cPanel, Aruba, Plesk).
# Su Cloudflare Pages, Netlify o Vercel questo file viene ignorato: li vale _headers.

# ---------- HTTPS e dominio senza www ----------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # forza HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://danova-tech.com/$1 [R=301,L]

  # forza il dominio senza www (una sola versione indicizzata)
  RewriteCond %{HTTP_HOST} ^www\.danova-tech\.com$ [NC]
  RewriteRule ^(.*)$ https://danova-tech.com/$1 [R=301,L]

  # toglie index.html dagli URL: /servizi/seo/index.html -> /servizi/seo/
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
</IfModule>

# ---------- Pagina 404 ----------
ErrorDocument 404 /404.html

# ---------- Compressione ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# ---------- Cache del browser ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ---------- Sicurezza ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  <FilesMatch "\.(woff2)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# ---------- Tipi MIME corretti ----------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
</IfModule>
